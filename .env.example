# App origin must exactly match the browser origin used for requests and OAuth redirects.
APP_ORIGIN=http://localhost:3001

# Supabase project URL and publishable/anon key. The Google provider must be enabled in Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me

# PostgreSQL connections. DATABASE_URL must use the restricted app_backend login role.
DATABASE_URL=postgresql://app_backend:replace-me@db.your-project.supabase.co:5432/postgres?sslmode=require
# Supply DATABASE_ADMIN_URL only to the one-time migration process; do not keep it in the app environment.

# Generate a random secret of at least 32 characters and keep it server-side only.
INVITE_CODE_PEPPER=replace-with-a-long-random-secret

# Kakao Developers JavaScript key. Register http://localhost:3001 as a JavaScript SDK domain.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Korea Meteorological Administration API Hub key, server-side only.
# Obtain from https://apihub.kma.go.kr/ (not a data.go.kr ServiceKey).
KMA_API_KEY=

# Gemini analysis is server-side only. Never add NEXT_PUBLIC_ to these variables.
# Enable only for an environment approved for use in this student-facing app.
GEMINI_STUDENT_USE_APPROVED=false
GEMINI_API_KEY=
# Exact Gemini API model ID supported by your approved environment.
GEMINI_MODEL=gemini-3.1-flash-lite

# Only configure this when a trusted reverse proxy strips client-supplied copies of the header.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
